    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $json.body;\n\nconst ip = data.src_ip;\nconst attack = data.attack_type;\nconst pps = data.packets_per_sec;\n\n// Initialize memory FIRST\nif (!globalThis.blockedIPs) {\n  globalThis.blockedIPs = {};\n}\n\nif (!globalThis.attackHistory) {\n  globalThis.attackHistory = {};\n}\n\n// 🔴 Skip if already blocked\nif (globalThis.blockedIPs[ip]) {\n  return {\n    json: {\n      ...data,\n      ip: ip,\n      skip: true\n    }\n  };\n}\n\n// Initialize IP history\nif (!globalThis.attackHistory[ip]) {\n  globalThis.attackHistory[ip] = {\n    attacks: [],\n    last_seen: Date.now()\n  };\n}\n\n// Store attack\nglobalThis.attackHistory[ip].attacks.push(attack);\n\n// Keep last 10\nif (globalThis.attackHistory[ip].attacks.length > 10) {\n  globalThis.attackHistory[ip].attacks.shift();\n}\n\n// Unique attacks\nconst uniqueAttacks = [...new Set(globalThis.attackHistory[ip].attacks)];\n\nlet classification = \"SINGLE_ATTACK\";\nlet severity = \"LOW\";\n\nif (uniqueAttacks.length >= 2) {\n  classification = \"MULTI_VECTOR_ATTACK\";\n  severity = \"MEDIUM\";\n}\n\nif (pps > 2000) {\n  severity = \"HIGH\";\n}\n\nif (uniqueAttacks.length >= 2 && pps > 1500) {\n  classification = \"ADVANCED_MULTI_VECTOR_ATTACK\";\n  severity = \"CRITICAL\";\n}\n\n// ✅ Mark as blocked (only first time)\nglobalThis.blockedIPs[ip] = true;\n\n// ✅ Final return (OBJECT, not array)\nreturn {\n  json: {\n    ip: ip,\n    src_ip: ip,\n    attack: attack,\n    classification: classification,\n    severity: severity,\n    history: globalThis.attackHistory[ip].attacks.join(\", \"),\n    history_count: globalThis.attackHistory[ip].attacks.length,\n    unique_attack_types: uniqueAttacks.length,\n    packets_per_sec: pps,\n    skip: false\n  }\n};"
      },
