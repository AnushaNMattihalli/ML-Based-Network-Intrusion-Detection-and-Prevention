        "jsCode": "const ip = $json.ip;\n\n// Ensure memory exists\nif (!globalThis.attackHistory) {\n  globalThis.attackHistory = {};\n}\n\n// Ensure IP exists\nif (!globalThis.attackHistory[ip]) {\n  globalThis.attackHistory[ip] = {\n    attacks: []\n  };\n}\n\nconst history = globalThis.attackHistory[ip].attacks;\n\nconst uniqueAttacks = [...new Set(history)];\n\nlet classification = \"SINGLE_ATTACK\";\nlet severity = \"LOW\";\n\nif (uniqueAttacks.length >= 2) {\n  classification = \"MULTI_VECTOR_ATTACK\";\n  severity = \"MEDIUM\";\n}\n\nif ($json.packets_per_sec > 2000) {\n  severity = \"HIGH\";\n}\n\nif (uniqueAttacks.length >= 2 && $json.packets_per_sec > 1500) {\n  classification = \"ADVANCED_MULTI_VECTOR_ATTACK\";\n  severity = \"CRITICAL\";\n}\n\nreturn {\n  json: {\n    ...$json,\n    classification: classification,\n    severity: severity,\n    unique_attack_types: uniqueAttacks.length\n  }\n};"
